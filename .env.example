# CyberTriage Environment Configuration Template
# Copy this file to .env and replace placeholder values with your own credentials.
# Never commit .env or real API keys to version control.

# Google Gemini API Key (required for live Gemini function calling)
GEMINI_API_KEY=

# Gemini Model identifier (optional, defaults to gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

# Switch Core Agent Registration Token (optional, used for initial agent registration with Switch Core)
AGENT_REGISTRATION_TOKEN=
